{
  "name": "lastro",
  "private": true,
  "packageManager": "bun@1.2.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "check": "turbo run check && bun run check:notices",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "test:integration": "turbo run test:integration --filter=@lastro/testing",
    "db:migrate": "turbo run migrate --filter=@lastro/db",
    "dev": "turbo run dev",
    "check:notices": "bun scripts/check-notices.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@types/node": "^22.7.4",
    "bun-types": "^1.2.0",
    "turbo": "^2.3.3",
    "typescript": "^5.6.3"
  }
}
