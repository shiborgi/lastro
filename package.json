{
  "name": "lastro",
  "version": "0.1.0",
  "private": true,
  "packageManager": "bun@1.4.0",
  "workspaces": ["apps/*", "packages/*", "modules/*"],
  "scripts": {
    "check": "turbo run check && bun run check:notices && bun run check:secrets && bun run check:private",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "test:integration": "turbo run test:integration --filter=@lastro/testing",
    "db:init": "cd packages/host && bun run db:init",
    "db:regenerate": "cd packages/host && bun run db:regenerate",
    "bootstrap": "bun scripts/bootstrap.ts",
    "dev": "turbo run dev",
    "check:notices": "bun scripts/check-notices.ts",
    "check:secrets": "bun scripts/check-secrets.ts",
    "check:private": "bun scripts/check-private.ts",
    "backup": "bun scripts/backup-restore.ts backup",
    "restore": "bun scripts/backup-restore.ts restore",
    "apple-container": "bun scripts/apple-container.ts",
    "seed:demo": "bun scripts/seed-demo.ts",
    "release:gate": "bun scripts/release-gate.ts",
    "smoke": "bun packages/testing/src/smoke.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@types/node": "^22.7.4",
    "bun-types": "^1.2.0",
    "turbo": "^2.3.3",
    "typescript": "^5.6.3"
  }
}
