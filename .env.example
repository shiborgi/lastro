# Copy to .env and fill in. Never commit the result.

# --- Database -------------------------------------------------------------
# Password for the bundled Postgres container. Change it before exposing the
# stack to anything but localhost.
LASTRO_DB_PASSWORD=lastro
# Used by tooling run from the host (bun run db:init, bun run bootstrap).
# Inside Compose the services build their own URL from LASTRO_DB_PASSWORD.
DATABASE_URL=postgres://lastro:lastro@localhost:5432/lastro

# --- Authentication -------------------------------------------------------
# Signs and encrypts session cookies. Must be at least 32 characters.
#   openssl rand -base64 32
BETTER_AUTH_SECRET=
# Public origin of the API service.
BETTER_AUTH_URL=http://localhost:3001
# Extra origins allowed to carry credentials, comma separated. The web app
# reaches the API through its own proxy, so this is usually left empty.
LASTRO_TRUSTED_ORIGINS=
# Open sign-up is off by default: accounts are created with `bun run bootstrap`.
# Set to true only if you want anyone reaching the API to register.
LASTRO_ALLOW_SIGNUP=false

# --- Services -------------------------------------------------------------
# Where the web app finds the API. In Compose this is http://api:3001.
LASTRO_API_URL=http://127.0.0.1:3001
# Bind address; containers need 0.0.0.0, a local run should stay on loopback.
HOST=127.0.0.1

# --- MCP ------------------------------------------------------------------
# Only needed for the stdio transport, where the process cannot negotiate
# credentials over HTTP. `bun run bootstrap` prints both values.
# MCP_BEARER_TOKEN=
# MCP_BOOK_ID=
