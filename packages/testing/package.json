{
  "name": "@lastro/testing",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "test": "bun test src/fitness.test.ts",
    "test:integration": "bun src/integration/run.ts",
    "build": "bun build ./src/index.ts --outdir dist --target bun --packages=external --external '@lastro/*'",
    "check": "bun run typecheck && bun run lint && bun run test && bun run build"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "drizzle-orm": "^0.45.2",
    "@lastro/host": "workspace:*",
    "@lastro/kernel": "workspace:*",
    "@lastro/core": "workspace:*",
    "postgres": "^3.4.4",
    "zod": "^4.5.4",
    "@lastro/finance": "workspace:*",
    "@lastro/sales": "workspace:*"
  },
  "devDependencies": {
    "typescript": "^5.6.3",
    "@types/node": "^22.7.4"
  }
}
