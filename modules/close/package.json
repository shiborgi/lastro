{
  "name": "@lastro/close",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./contracts": "./src/contracts/index.ts",
    "./testing": "./src/testing.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "test": "bun test --pass-with-no-tests",
    "build": "bun build ./src/index.ts --outdir dist --target bun --packages=external --external '@lastro/*'",
    "check": "bun run typecheck && bun run lint && bun run test && bun run build"
  },
  "devDependencies": {
    "typescript": "^5.6.3",
    "@types/node": "^22.7.4"
  },
  "dependencies": {
    "@lastro/kernel": "workspace:*",
    "@lastro/core": "workspace:*",
    "@lastro/finance": "workspace:*",
    "@lastro/sales": "workspace:*",
    "zod": "^4.5.4"
  }
}
